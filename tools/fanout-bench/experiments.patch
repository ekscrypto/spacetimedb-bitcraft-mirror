+/// EXPERIMENT: row-count threshold below which v1 messages are encoded inline
+/// instead of on Rayon, from `STDB_WS_V1_INLINE_ENCODE_MAX_ROWS`.
+fn ws_v1_inline_encode_max_rows() -> Option<usize> {
+    static MAX: std::sync::OnceLock<Option<usize>> = std::sync::OnceLock::new();
+    *MAX.get_or_init(|| {
+        std::env::var("STDB_WS_V1_INLINE_ENCODE_MAX_ROWS")
+            .ok()
+            .and_then(|v| v.parse().ok())
+    })
+}
+
+/// EXPERIMENT: outbound batching window, from `STDB_WS_SEND_LINGER_MS`
+/// (fractional milliseconds allowed). `None` (the default) keeps the stock
+/// behaviour of encoding whatever is queued the moment the task wakes.
+fn ws_send_linger() -> Option<Duration> {
+    static LINGER: std::sync::OnceLock<Option<Duration>> = std::sync::OnceLock::new();
+    *LINGER.get_or_init(|| {
+        std::env::var("STDB_WS_SEND_LINGER_MS")
+            .ok()
+            .and_then(|v| v.parse::<f64>().ok())
+            .filter(|ms| *ms > 0.0)
+            .map(|ms| Duration::from_secs_f64(ms / 1000.0))
+    })
+}
